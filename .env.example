NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitoring

# JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Google OAuth (Client ID dari Google Cloud Console)
GOOGLE_CLIENT_ID=
